# ============================================================
# Telegram 通知設定：照著下面 3 步做，把值貼到最下面兩行就好
# ============================================================
#
# 【步驟 1】拿 Bot Token
#   1. 打開 Telegram，上面搜尋框輸入  @BotFather  ，點進去按「開始 / START」
#   2. 傳送：/newbot
#   3. 它問 name    → 隨便打，例如：台指期籌碼
#   4. 它問 username → 必須是英文且結尾是 bot，例如：jerry_taifex_bot
#   5. 它會回你一串像這樣的東西：
#        8123456789:AAFk9xLm2QwErTyUiOpAsDfGhJkL_zXcVbN
#      整串複製（含中間的冒號），貼到最下面 TELEGRAM_BOT_TOKEN= 後面
#
# 【步驟 2】拿你的 chat ID
#   1. 在 Telegram 搜尋  @userinfobot  ，點進去按「開始 / START」
#   2. 它會馬上回你，其中  Id: 123456789  那串數字就是你的 chat ID
#
# 【步驟 3】先跟自己的 bot 講一句話（很重要，漏掉一定送不出去）
#   1. 在 Telegram 搜尋步驟 1 你取的 username（例如 jerry_taifex_bot）
#   2. 點進去按「開始 / START」，隨便打個「hi」送出
#      Telegram 規定使用者要先開口，bot 才有資格傳訊息給你
#
# ------------------------------------------------------------
# 填完長這樣（這是範例，不要照抄數字）：
#   TELEGRAM_BOT_TOKEN=8123456789:AAFk9xLm2QwErTyUiOpAsDfGhJkL_zXcVbN
#   TELEGRAM_CHAT_IDS=我:123456789
#
# 要傳給多個人，就用逗號串起來，「冒號前面是你自己看的名字」：
#   TELEGRAM_CHAT_IDS=我:123456789,老婆:987654321,交易群:-1001234567890
#   （每個人都要各自做步驟 2、3；群組的 ID 是負數）
#
# 改完存檔後，要重開 npm run dev 才會生效
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_IDS=

# ============================================================
# 登入設定：沒設定的話，網站會擋住所有人（包含你自己）
# ============================================================
#
# 【AUTH_USERS】可以登入的帳號，密碼只存雜湊值、不存明碼
#   1. 在專案資料夾執行：npm run hash-password -- 帳號
#   2. 輸入兩次密碼，它會印出一行像這樣的東西：
#        ck:pbkdf2.100000.JVfvnEBuoX4Sz_BIxGi5XA.04kIN2nEYybDD87G...
#      整行貼到 AUTH_USERS= 後面
#   3. 多個帳號用逗號串起來：AUTH_USERS=ck:pbkdf2...,老婆:pbkdf2...
#   要刪帳號或改密碼：刪掉那筆或換成新產生的那行，重開後舊的登入就失效
#
# 【AUTH_SECRET】簽章登入狀態用的隨機字串，至少 32 個字元
#   產生方式：node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
#   換掉這個值會讓所有人都被登出
# ------------------------------------------------------------

AUTH_USERS=

AUTH_SECRET=
